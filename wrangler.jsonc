{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 이 이름은 클라우드플레어 대시보드의 Worker 이름(주소 맨 앞부분)과 같아야 해요.
  "name": "numberchess",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // 배포 전에 게임 화면을 만들어요(npm run build → dist/)
  "build": { "command": "npm run build" },
  // 게임 화면 파일: vite가 만든 dist/ 폴더
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // STORE: 로그인·기록·도감·친구 유령·랭크 점수·방 목록 / ROOM: 온라인 대결 방(방마다 하나, 끝나면 지움)
  // 무료 플랜은 SQLite 방식만 가능
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "Store" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Store"] },
    { "tag": "v2", "new_sqlite_classes": ["Room"] }
  ],
  // 로그: 무료 플랜은 하루 20만 건(같은 계정의 다른 게임과 함께 씀) → 10번 중 1번만 저장. 게임 동작과는 상관없음
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
